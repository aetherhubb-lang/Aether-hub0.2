local function filteredEggs()
    local anyFilter = false
    for _, rarity in ipairs(rarities) do
        if uiState.filters[rarity.Key] then
            anyFilter = true
            break
        end
    end
    local result = {}
    for _, egg in ipairs(eggRecords) do
        if not anyFilter or uiState.filters[egg.Key] then
            result[#result + 1] = egg
        end
    end
    return result
end

local function refreshRows()
    local list = filteredEggs()
    for i, item in ipairs(rows) do
        local match = list[i]
        item.Button.Visible = uiState.dropdownOpen and match ~= nil
        if match then
            item.Egg = match
            item.Button.Name = "EggRow" .. i .. "_" .. match.Key
            local indexLabel = item.Button:FindFirstChild("Index")
            if indexLabel then indexLabel.Text = "#" .. i end
            local nameLabel = item.Button:FindFirstChild("EggName")
            if nameLabel then nameLabel.Text = match.Name end
            local rarityLabel = item.Button:FindFirstChild("EggRarity")
            if rarityLabel then
                rarityLabel.Text = match.Rarity
                rarityLabel.TextColor3 = match.Color
            end
            local valueLabel = item.Button:FindFirstChild("Value")
            if valueLabel then valueLabel.Text = match.Value end
            local mark = item.Button:FindFirstChild("PreviewTile") and item.Button.PreviewTile:FindFirstChild("Mark")
            if mark then mark.TextColor3 = match.Color end
            item.Icon.Image = match.Icon or ""
            item.Icon.Visible = item.Icon.Image ~= ""
            item.Mark.Visible = not item.Icon.Visible
        end
    end
    local shown = math.min(#list, visibleRowCount)
    filterTitle.Position = UDim2.fromOffset(0, shown * (rowHeight + rowGap) + 4)
    filterList.Position = UDim2.fromOffset(0, shown * (rowHeight + rowGap) + 26)
end

local function refreshSelection()
    local list = filteredEggs()
    local found = false
    if uiState.selected then
        for _, egg in ipairs(list) do
            if egg.Uid == uiState.selected.Uid then
                uiState.selected = egg
                found = true
                break
            end
        end
    end
    if not found then uiState.selected = list[1] end
    if uiState.selected then
        eggName.Text = uiState.selected.Name
        eggRarity.Text = uiState.selected.Rarity
        eggRarity.TextColor3 = uiState.selected.Color
        eggValue.Text = uiState.selected.Value
        previewMark.TextColor3 = uiState.selected.Color
        mainPreviewImage.Image = uiState.selected.Icon or ""
        mainPreviewImage.Visible = mainPreviewImage.Image ~= ""
        previewMark.Visible = not mainPreviewImage.Visible
    else
        eggName.Text = "NO EGG FOUND"
        eggRarity.Text = ""
        eggValue.Text = "--"
        previewMark.TextColor3 = COLORS.muted
        previewMark.Visible = true
        mainPreviewImage.Image = ""
        mainPreviewImage.Visible = false
    end
    refreshRows()
end

