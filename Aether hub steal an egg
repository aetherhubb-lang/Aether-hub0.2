local panelToken = 0
local function openPanel()
    panelToken += 1
    panelOpen = true
    uiState.panelOpen = true
    panel.Visible = true
    local token = panelToken
    panel.Size = UDim2.fromOffset(244, 170)
    local anim = tween(panel, 0.22, { Size = UDim2.fromOffset(262, 185) }, Enum.EasingStyle.Back)
    anim.Completed:Once(function()
        if token ~= panelToken then return end
    end)
end
local function closePanel()
    if not panelOpen then return end
    if cancelAutomation then cancelAutomation() end
    panelToken += 1
    panelOpen = false
    uiState.panelOpen = false
    if uiState.dropdownOpen then setDropdown(false) end
    local token = panelToken
    local anim = tween(panel, 0.16, { Size = UDim2.fromOffset(244, 170) }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
    anim.Completed:Once(function()
        if token == panelToken and not panelOpen then panel.Visible = false end
    end)
end
