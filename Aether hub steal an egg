local automationGeneration = 0

cancelAutomation = function()
    if not uiState.enabled and not gameState.Busy then return end
    uiState.enabled = false
    automationGeneration += 1
    gameState.Cancel = true
    updateControls()
    status("Cancelling")
end

local function startAutomation()
    automationGeneration += 1
    local generation = automationGeneration
    task.spawn(function()
        local attempted = {}
        local firstTarget = true
        while uiState.enabled and automationGeneration == generation do
            local target
            if firstTarget and uiState.selected then
                target = uiState.selected
                firstTarget = false
            else
                refreshEggRecords()
                for _, candidate in ipairs(filteredEggs()) do
                    if not attempted[candidate.Uid] then
                        target = candidate
                        break
                    end
                end
            end
            if not target then
                status("No more matching eggs")
                break
            end
            attempted[target.Uid] = true
            uiState.selected = target
            refreshSelection()
            gameState.Cancel = false
            stealAndDeliver(target.Uid)
            while gameState.Busy and uiState.enabled and automationGeneration == generation do
                task.wait(0.1)
            end
            if not uiState.enabled or automationGeneration ~= generation or not uiState.loop then
                break
            end
            task.wait(0.3)
        end
        shieldStop()
        if automationGeneration == generation then
            uiState.enabled = false
            updateControls()
        end
    end)
end

local function toggleAutomation()
    if uiState.enabled or gameState.Busy then
        cancelAutomation()
        showToast("Stopping current run")
        return
    end
    refreshEggRecords()
    refreshSelection()
    if not uiState.selected then
        status("No matching egg found")
        showToast("No matching egg found")
        return
    end
    uiState.enabled = true
    gameState.Cancel = false
    shieldStart()
    updateControls()
    showToast("Started: " .. uiState.selected.Name)
    startAutomation()
end
