		if carrying and type(arg.Uid) == "string" then
			gameState.Uid = arg.Uid
			local mult = tonumber(arg.SpeedMultiplier)
			if mult and mult > 0 then
				gameState.Mult = mult
			end
		end
		gameState.Carrying = carrying
	end)
end

