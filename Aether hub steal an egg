local function refreshEggRecords()
    local updated = {}
    for _, record in ipairs(snapshot()) do
        local info = describe(record)
        local directory = type(Assets) == "table" and Assets.Directory or nil
        local entry = type(directory) == "table" and directory[info.Category] or nil
        local rarity = type(entry) == "table" and entry.Rarity or nil
        local rarityName = type(rarity) == "table" and tostring(rarity.DisplayName or rarity.Name or "") or ""
        local rarityRank = tonumber(info.Rarity) or 0
        local numericValue = tonumber(info.Value) or 0
        updated[#updated + 1] = {
            Uid = info.Uid,
            Name = info.Name,
            Rarity = rarityName ~= "" and rarityName or "Unknown",
            Key = string.lower(rarityName):gsub("%s+", ""),
            ValueNumber = numericValue,
            Value = money(numericValue),
            Color = rarityColorsByRank[math.clamp(rarityRank, 1, #rarityColorsByRank)] or COLORS.pale,
            Icon = info.Icon or "",
        }
    end
    table.sort(updated, function(a, b) return a.ValueNumber > b.ValueNumber end)
    eggRecords = updated
    return true
end

