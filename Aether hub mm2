local function criarSlider(parent, texto, min, max, padrao, order, callback)
    local c = Instance.new("Frame", parent)
    c.Size = UDim2.new(1, -20, 0, 45); c.BackgroundColor3 = Color3.fromRGB(22, 15, 35)
    c.BorderSizePixel = 0; c.LayoutOrder = order; c.ZIndex = 2
    Instance.new("UICorner", c).CornerRadius = UDim.new(0, 6)
    local cs = Instance.new("UIStroke", c); cs.Color = Theme.LineColor; cs.Thickness = 1; cs.Transparency = 0.5

    local lb = Instance.new("TextLabel", c)
    lb.Size = UDim2.new(1, -20, 0, 20); lb.Position = UDim2.new(0, 10, 0, 4)
    lb.BackgroundTransparency = 1; lb.Text = texto .. ": " .. padrao
    lb.TextColor3 = Theme.Text; lb.Font = Enum.Font.GothamMedium; lb.TextSize = 12
    lb.TextXAlignment = Enum.TextXAlignment.Left; lb.ZIndex = 3

    local bar = Instance.new("Frame", c)
    bar.Size = UDim2.new(0.9, 0, 0, 6); bar.Position = UDim2.new(0.05, 0, 0, 30)
    bar.BackgroundColor3 = Color3.fromRGB(50, 50, 60); bar.BorderSizePixel = 0; bar.ZIndex = 3
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame", bar)
    fill.Size = UDim2.new((padrao - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Theme.Accent; fill.BorderSizePixel = 0; fill.ZIndex = 4
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local handle = Instance.new("TextButton", bar)
    handle.Size = UDim2.new(0, 20, 0, 20); handle.Position = UDim2.new((padrao - min) / (max - min), -10, 0.5, -10)
    handle.BackgroundTransparency = 1; handle.Text = "●"; handle.TextColor3 = Theme.Text
    handle.Font = Enum.Font.GothamBold; handle.TextSize = 18; handle.ZIndex = 5

    local arrastando = false
    local function update(input)
        local pX = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        fill.Size = UDim2.new(pX, 0, 1, 0)
        handle.Position = UDim2.new(pX, -10, 0.5, -10)
        local v = math.floor(min + ((max - min) * pX))
        lb.Text = texto .. ": " .. v
        if callback then callback(v) end
    end
    handle.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then arrastando = true end end)
    bar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then arrastando = true; update(i) end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then arrastando = false end end)
    UserInputService.InputChanged:Connect(function(i) if arrastando and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then update(i) end end)
end

local SpeedAtual = 16
local JumpAtual = 50
local FlySpeed = 60
local NoclipAtivo = false
local flyState = { on = false, conn = nil }

local function setFly(on)
    flyState.on = on
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if on then
        if not hrp then return end
        local bv = Instance.new("BodyVelocity", hrp)
        bv.Name = "AetherFly"; bv.MaxForce = Vector3.new(1e5,1e5,1e5)
        local bg = Instance.new("BodyGyro", hrp)
        bg.Name = "AetherGyro"; bg.P = 1e4; bg.MaxTorque = Vector3.new(1e5,1e5,1e5); bg.CFrame = hrp.CFrame
        flyState.conn = RunService.RenderStepped:Connect(function()
            if not flyState.on then return end
            local h = char and char:FindFirstChild("HumanoidRootPart")
            if not h then return end
            local cam = workspace.CurrentCamera
            local dir = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then dir += cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then dir -= cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then dir -= cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then dir += cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0,1,0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.new(0,1,0) end
            bv.Velocity = dir.Magnitude > 0 and (dir.Unit * FlySpeed) or Vector3.zero
            bg.CFrame = cam.CFrame
        end)
    else
        if flyState.conn then flyState.conn:Disconnect(); flyState.conn = nil end
        if hrp then
            if hrp:FindFirstChild("AetherFly") then hrp.AetherFly:Destroy() end
            if hrp:FindFirstChild("AetherGyro") then hrp.AetherGyro:Destroy() end
        end
    end
end

RunService.Stepped:Connect(function()
    if LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            if hum.WalkSpeed ~= SpeedAtual then hum.WalkSpeed = SpeedAtual end
            if hum.JumpPower ~= JumpAtual then hum.UseJumpPower = true; hum.JumpPower = JumpAtual end
        end
        if NoclipAtivo then
            for _, v in ipairs(LocalPlayer.Character:GetDescendants()) do
                if v:IsA("BasePart") and v.CanCollide then v.CanCollide = false end
            end
        end
    end
end)-- ============================================================
