-- [KEYBINDS]
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    local k = input.KeyCode
    if k == KEYBINDS.Fly then
        setFly(not flyState.on)
        Notify(flyState.on and "✈️ Fly ON" or "✈️ Fly OFF", Theme.Accent)
    elseif k == KEYBINDS.Noclip then
        NoclipAtivo = not NoclipAtivo
        Notify(NoclipAtivo and "👻 Noclip ON" or "👻 Noclip OFF", Theme.Accent)
    elseif k == KEYBINDS.InfiniteJump then
        setInfiniteJump(not CONFIG2.InfiniteJump)
        Notify(CONFIG2.InfiniteJump and "🦘 Inf Jump ON" or "🦘 Inf Jump OFF", Theme.Accent)
    elseif k == KEYBINDS.AntiVoid then
        setAntiVoid(not CONFIG2.AntiVoid)
        Notify(CONFIG2.AntiVoid and "💀 Anti-Void ON" or "💀 Anti-Void OFF", Theme.Accent)
    elseif k == KEYBINDS.HideUI then
        U.MainFrame.Visible = not U.MainFrame.Visible
    elseif k == KEYBINDS.Panic then
        pcall(function()
            setFly(false); setAntiVoid(false); setAntiRagdoll(false); setAntiFling(false)
            setAntiTP(false); setInfiniteJump(false); setSpider(false); setClickTP(false)
            setFreeze(false); setHitboxExpander(false); setAutoThrowKnife(false)
            setAutoShoot(false); setCoinMagnet(false); setGodMode(false)
            NoclipAtivo = false; CONFIG2.Watermark = false
            U.MainFrame.Visible = false
            Notify("🚨 PÂNICO — tudo desligado", Color3.fromRGB(255, 80, 80))
        end)
    end
end)

