local function criarToggle(parent, texto, layoutOrder, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -10, 0, 42) 
    row.BackgroundColor3 = Color3.fromRGB(25, 15, 35)
    row.BorderSizePixel = 0
    row.LayoutOrder = layoutOrder
    row.ZIndex = 2
    row.Parent = parent
    
    local rowC = Instance.new("UICorner"); rowC.CornerRadius = UDim.new(0, 8); rowC.Parent = row
    local rowStroke = Instance.new("UIStroke"); rowStroke.Color = Theme.Outline; rowStroke.Thickness = 1.5; rowStroke.Parent = row

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, -80, 1, 0)
    txt.Position = UDim2.new(0, 15, 0, 0)
    txt.BackgroundTransparency = 1
    txt.Text = texto
    txt.TextColor3 = Theme.Text
    txt.Font = Enum.Font.Gotham
    txt.TextSize = 13
    txt.TextXAlignment = Enum.TextXAlignment.Left
    txt.ZIndex = 3
    txt.Parent = row

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.ZIndex = 4
    btn.Parent = row

    local toggleBg = Instance.new("Frame")
    toggleBg.Size = UDim2.new(0, 40, 0, 22)
    toggleBg.Position = UDim2.new(1, -55, 0.5, -11)
    toggleBg.BackgroundColor3 = Theme.ToggleOff
    toggleBg.ZIndex = 3
    toggleBg.Parent = row
    local bgC = Instance.new("UICorner"); bgC.CornerRadius = UDim.new(1, 0); bgC.Parent = toggleBg

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.Position = UDim2.new(0, 3, 0.5, -8)
    knob.BackgroundColor3 = Theme.ToggleKnob
    knob.ZIndex = 4
    knob.Parent = toggleBg
    local knobC = Instance.new("UICorner"); knobC.CornerRadius = UDim.new(1, 0); knobC.Parent = knob

    local isToggled = false
    btn.MouseButton1Click:Connect(function()
        isToggled = not isToggled
        if isToggled then
            TweenService:Create(toggleBg, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Accent}):Play()
            TweenService:Create(knob, TweenInfo.new(0.2), {Position = UDim2.new(1, -19, 0.5, -8)}):Play()
        else
            TweenService:Create(toggleBg, TweenInfo.new(0.2), {BackgroundColor3 = Theme.ToggleOff}):Play()
            TweenService:Create(knob, TweenInfo.new(0.2), {Position = UDim2.new(0, 3, 0.5, -8)}):Play()
        end
        if callback then callback(isToggled) end
    end)
end

