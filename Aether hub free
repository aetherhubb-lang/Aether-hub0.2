local isInvisible = false
local invisLoop = nil

local function AplicarInvisibilidade(char, ativo)
    if not char then return end
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") or part:IsA("Decal") or part:IsA("Texture") then
            part.Transparency = ativo and 1 or 0
        end
    end
end

local function toggleInvisibilidade(ativo)
    isInvisible = ativo
    
    if ativo then
        InvisPanel.Text = "(invisibilidade on)"
        InvisPanel.TextColor3 = Theme.Accent
        InvisStroke.Color = Theme.Accent
        
        AplicarInvisibilidade(LocalPlayer.Character, true)
        
        -- Otimização: loop mais lento (0.2s) para não travar o celular
        if not invisLoop then
            invisLoop = task.spawn(function()
                while isInvisible do
                    AplicarInvisibilidade(LocalPlayer.Character, true)
                    task.wait(0.2)
                end
            end)
        end
    else
        InvisPanel.Text = "(invisibilidade off)"
        InvisPanel.TextColor3 = Theme.TextDark
        InvisStroke.Color = Theme.Outline
        
        if invisLoop then task.cancel(invisLoop) invisLoop = nil end
        AplicarInvisibilidade(LocalPlayer.Character, false)
    end
end

-- Se o jogador morrer e der respawn, a invisibilidade continua se estiver ativa
LocalPlayer.CharacterAdded:Connect(function(newChar)
    task.wait(0.5)
    if isInvisible then
        AplicarInvisibilidade(newChar, true)
    end
end)

InvisPanel.MouseButton1Click:Connect(function() toggleInvisibilidade(not isInvisible) end)
criarToggle(PagePrincipal, "invisível", 1, function(ativo)
    InvisPanel.Visible = ativo
    if not ativo then toggleInvisibilidade(false) end
end)

