local function f1()
    local character = LocalPlayer.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function f2(p1, p2)
    if p1 == p2 then return false end
    local humanoidRootPart = p1:FindFirstChild("HumanoidRootPart")
    local humanoid = p1:FindFirstChildOfClass("Humanoid")
    return humanoidRootPart and humanoid and humanoid.Health > 0
end

local function f5()
    local v16 = f1()
    local character3, v17, huge
    if not v16 then return nil end
    character3 = LocalPlayer.Character
    v17 = nil
    huge = math.huge
    local function f6(p6)
        if not f2(p6, character3) then return end
        local humanoidRootPart3 = p6:FindFirstChild("HumanoidRootPart")
        if humanoidRootPart3 then
            local magnitude = (v16.Position - humanoidRootPart3.Position).Magnitude
            if magnitude <= DistanciaDetectcao and magnitude < huge then
                huge = magnitude
                v17 = p6
            end
        end
    end
    for index, value in ipairs(Players:GetPlayers()) do
        if value ~= LocalPlayer and value.Character then f6(value.Character) end
    end
    for index2, value2 in ipairs(workspace:GetDescendants()) do
        if value2:IsA("Model") then f6(value2) end
    end
    return v17
end

local function f4(p3, p4, p5)
    local character2 = LocalPlayer.Character
    if not character2 then return end
    local humanoidRootPart2 = character2:FindFirstChild("HumanoidRootPart")
    local humanoid2 = character2:FindFirstChildOfClass("Humanoid")
    if not humanoidRootPart2 or not humanoid2 or not p3 then return end
    humanoid2.AutoRotate = false
    local v9 = tick()
    local position = humanoidRootPart2.Position
    local v10 = p5 or 10
    local connect = nil
    connect = RunService.RenderStepped:Connect(function()
        if not p3 or not p3.Parent then
            humanoid2.AutoRotate = true
            connect:Disconnect()
            return
        else
            local v11 = tick()
            local v12 = math.clamp((v11 - v9) / p4, 0, 1)
            if v12 >= 1 then
                humanoid2.AutoRotate = true
                connect:Disconnect()
                return
            else
                local v13 = 1 - (1 - v12) ^ 3
                local cframe = p3.CFrame
                local position2 = cframe.Position
                local lerp = position:Lerp(position2 - cframe.LookVector * v10, v13)
                local v14 = math.sin(v13 * math.pi)
                humanoidRootPart2.CFrame = CFrame.lookAt(
                    lerp + cframe.RightVector * v14 * v10, position2
                )
                return
            end
        end
    end)
end

local v18 = false
if v15 and hookmetamethod then
    local v19 = hookmetamethod
    local v20
    v20 = v19(game, "__namecall", function(p7, ...)
        local v21 = getnamecallmethod() ~= "FireServer" or p7 ~= v15
        
        if v21 then
            return v20(p7, ...)
        elseif not KokusenAtivo then
            return v20(p7, ...)
        elseif v18 then
            return v20(p7, ...)
        else
            local v22 = { ... }
            v18 = true
            local v23 = v20(p7, ...)
            
            task.delay(0.31, function()
                pcall(function() v15:FireServer(table.unpack(v22)) end)
                v18 = false
            end)
            
            task.delay(0.1, function()
                if not SideDashAtivo then return end 
                
                local v24 = f5()
                if not v24 then return end
                local humanoidRootPart4 = v24:FindFirstChild("HumanoidRootPart")
                if not humanoidRootPart4 then return end
                
                local v25 = f1()
                local v26 = 10
                if v25 then
                    local dot = humanoidRootPart4.CFrame.LookVector:Dot(v25.CFrame.LookVector)
                    if dot > 0.5 then return end
                    if math.abs(dot) <= 0.5 then
                        v26 = 5
                    end
                    f4(humanoidRootPart4, 0.31, v26)
                    return
                end
                f4(humanoidRootPart4, 0.31, v26)
                return
            end)
            return v23
        end
    end)
end-- ============================================================
