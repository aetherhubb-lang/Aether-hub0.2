local function adicionarHighlight(obj)
    if not dominiosNoMapa[obj] then
        local hl = Instance.new("Highlight")
        hl.Adornee = obj
        hl.FillColor = Theme.Accent
        hl.FillTransparency = 0.7
        hl.OutlineColor = Color3.fromRGB(255, 100, 255)
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = pastaHighlights
        dominiosNoMapa[obj] = hl
        alerta.Visible = true
    end
end

-- Verifica se um objeto é um domain
local function checarObj(obj)
    if not ESP_Domain_Ativo then return end
    if not (obj:IsA("Model") or obj:IsA("BasePart")) then return end
    
    local nome = obj.Name:lower()
    for _, nomeProcurado in ipairs(NOMES_PROCURADOS) do
        if nome:find(nomeProcurado:lower()) then
            adicionarHighlight(obj)
            break
        end
    end
end

-- Verifica o que já existe no mapa ao ligar
