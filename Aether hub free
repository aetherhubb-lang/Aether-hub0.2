local isInvisible = false
local invisConnection = nil

local function toggleInvisibilidade(ativo)
    isInvisible = ativo
    if ativo then
        InvisPanel.Text = "(invisibilidade on)"
        InvisPanel.TextColor3 = Theme.Accent
        InvisStroke.Color = Theme.Accent
        if not invisConnection then
            invisConnection = RunService.Heartbeat:Connect(function()
                local char = LocalPlayer.Character
                if char then
                    for _, part in pairs(char:GetDescendants()) do
                        if part:IsA("BasePart") or part:IsA("Decal") or part:IsA("Texture") then
                            pcall(function() part.Transparency = 1 end)
                        end
                    end
                end
            end)
        end
    else
        InvisPanel.Text = "(invisibilidade off)"
        InvisPanel.TextColor3 = Theme.TextDark
        InvisStroke.Color = Theme.Outline
        if invisConnection then invisConnection:Disconnect() invisConnection = nil end
        local char = LocalPlayer.Character
        if char then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") or part:IsA("Decal") or part:IsA("Texture") then
                    pcall(function() part.Transparency = 0 end)
                end
            end
        end
    end
end

InvisPanel.MouseButton1Click:Connect(function() toggleInvisibilidade(not isInvisible) end)

