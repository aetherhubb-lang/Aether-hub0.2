local function criarSlider(parent, texto, min, max, padrao, layoutOrder, callback)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, -20, 0, 45)
    container.BackgroundColor3 = Color3.fromRGB(22, 15, 35)
    container.BorderSizePixel = 0; container.LayoutOrder = layoutOrder; container.ZIndex = 2; container.Parent = parent
