local dragging, dragInput, dragStart, startPos, currentDragFrame
local function makeDraggable(frameToDrag, dragArea)
    dragArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            currentDragFrame = frameToDrag
            dragStart = input.Position
            startPos = frameToDrag.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    dragArea.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
end

makeDraggable(MainFrame, TopBar)
makeDraggable(MainFrame, MiniPanel)
makeDraggable(InvisPanel, InvisPanel)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging and currentDragFrame then
        local delta = input.Position - dragStart
        currentDragFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

local isMinimized = false
local function Minimizar()
    isMinimized = true
    TopBar.Visible = false; TabBar.Visible = false; ContentArea.Visible = false; MiniPanel.Visible = true
    TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back), {Size = TAMANHO_MINI}):Play()
end

local function Restaurar()
    isMinimized = false
    MiniPanel.Visible = false
    TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back), {Size = TAMANHO_NORMAL}):Play()
    task.wait(0.1)
    TopBar.Visible = true; TabBar.Visible = true; ContentArea.Visible = true
end

MinBtn.MouseButton1Click:Connect(function() if not isMinimized then Minimizar() end end)
