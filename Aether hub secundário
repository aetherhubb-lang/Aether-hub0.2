-- ================= CONFIGURAÇÕES =================
local ConfigBtn, ConfigNome = criarLinhaExtras("⚙️ Configurações", 1)
local ConfigAberto = false
local ConfigConexoes = {}

local function fecharConfigs()
    for _, nome in ipairs({"FullbrightRow", "InfiniteJumpRow", "RejoinRow", "CorRow"}) do
        local r = ExtrasContent:FindFirstChild(nome)
        if r then r:Destroy() end
    end
    for _, c in pairs(ConfigConexoes) do pcall(function() c:Disconnect() end) end
    ConfigConexoes = {}

    pcall(function()
        local L = game:GetService("Lighting")
        L.Brightness = 1
        L.GlobalShadows = true
    end)

    ConfigAberto = false
    setLinhaAtiva(ConfigBtn, ConfigNome, false)
end

local function abrirConfigs()
    ConfigAberto = true
    setLinhaAtiva(ConfigBtn, ConfigNome, true)

    -- FULLBRIGHT
    local FullBtn, FullNome = criarLinhaExtras("🌟 Fullbright", 2)
    FullBtn.Parent.Name = "FullbrightRow"
    FullBtn.MouseButton1Click:Connect(function()
        local ativo = not FullBtn:GetAttribute("ativo")
        setLinhaAtiva(FullBtn, FullNome, ativo)
        local L = game:GetService("Lighting")
        if ativo then
            L.Brightness = 5
            L.ClockTime = 14
            L.FogEnd = 100000
            L.GlobalShadows = false
        else
            L.Brightness = 1
            L.GlobalShadows = true
        end
    end)

    -- INFINITE JUMP
    local JumpBtn, JumpNome = criarLinhaExtras("🦘 Infinite Jump", 3)
    JumpBtn.Parent.Name = "InfiniteJumpRow"
    JumpBtn.MouseButton1Click:Connect(function()
        local ativo = not JumpBtn:GetAttribute("ativo")
        setLinhaAtiva(JumpBtn, JumpNome, ativo)
        if ativo then
            local con = UserInputService.JumpRequest:Connect(function()
                if not JumpBtn:GetAttribute("ativo") then return end
                local char = lp.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
            end)
            table.insert(ConfigConexoes, con)
        end
    end)

    -- REJOIN
    local RejoinBtn = criarLinhaExtras("🔄 Rejoin Server", 4)
    RejoinBtn.Parent.Name = "RejoinRow"
    RejoinBtn.MouseButton1Click:Connect(function()
        RejoinBtn.Text = "🔄 Reconectando..."
        task.wait(0.5)
        pcall(function()
            game:GetService("TeleportService"):Teleport(game.PlaceId, lp)
        end)
    end)
end

ConfigBtn.MouseButton1Click:Connect(function()
    if ConfigAberto then
        fecharConfigs()
    else
        abrirConfigs()
    end
end)
