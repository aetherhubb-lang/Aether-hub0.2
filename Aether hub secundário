local function criarLinha(nomeBase, layoutOrder)
    local row = Instance.new("Frame")
    row.Name = nomeBase .. "Row"
    row.Size = UDim2.new(1, 0, 0, 42)
    row.BackgroundTransparency = 1
    row.LayoutOrder = layoutOrder or 99
    row.Parent = Content

    local btn = Instance.new("TextButton")
    btn.Name = nomeBase .. "Button"
    btn.Size = UDim2.new(1, 0, 1, -1)
    btn.BackgroundTransparency = 1
    btn.Text = nomeBase .. ": OFF"
    btn.TextColor3 = COR_TEXTO_OFF
    btn.TextSize = 14
    btn.Font = Enum.Font.GothamBold
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.Parent = row

    local div = Instance.new("Frame")
    div.Size = UDim2.new(0.92, 0, 0, 1)
    div.Position = UDim2.new(0.04, 0, 1, -1)
    div.BackgroundColor3 = COR_DIVISOR
    div.BorderSizePixel = 0
    div.Parent = row

    btn.MouseEnter:Connect(function()
        if not btn:GetAttribute("ativo") then btn.TextColor3 = COR_TEXTO end
    end)
    btn.MouseLeave:Connect(function()
        if not btn:GetAttribute("ativo") then btn.TextColor3 = COR_TEXTO_OFF end
    end)

    return btn, nomeBase
end

