local isMinimized = false
local MIN_PANEL_SIZE = UDim2.new(0, 60, 0, 60)

function minimizar()
    isMinimized = true
    Header.Visible = false
    Content.Visible = false
    ExtrasContent.Visible = false
    MiniPanel.Visible = true
    TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = MIN_PANEL_SIZE,
    }):Play()
    MainFrame.Draggable = true
end

function restaurar()
    isMinimized = false
    TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = NORMAL_SIZE,
    }):Play()
    MiniPanel.Visible = false
    Header.Visible = true
    Content.Visible = true
    MainFrame.Draggable = LockButton.Text == "🔓"
end

