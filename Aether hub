local GojoButton = criarBotao("Gojo 0.2", 1)
local indiceGojo = 1

GojoButton.MouseButton1Click:Connect(function()
    Estado.GojoAtivo = not Estado.GojoAtivo

    if Estado.GojoAtivo then
        GojoButton.BackgroundColor3 = CONFIG.COR_BOTAO_ATIVO
        GojoButton.Text = "Gojo 0.2 ✓"
        indiceGojo = 1

        local conexaoGojo = RunService.Heartbeat:Connect(function()
            if not Estado.GojoAtivo then return end

            local char = LocalPlayer.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            -- Monta lista de jogadores VIVOS (exceto eu)
            local vivos = {}
            for _, jogador in pairs(Players:GetPlayers()) do
                if jogador ~= LocalPlayer then
                    local charAlvo = jogador.Character
                    if charAlvo then
                        local hum = charAlvo:FindFirstChild("Humanoid")
                        local hrpAlvo = charAlvo:FindFirstChild("HumanoidRootPart")
                        if hum and hum.Health > 0 and hrpAlvo then
                            table.insert(vivos, hrpAlvo)
                        end
                    end
                end
            end

            if #vivos == 0 then return end
            if indiceGojo > #vivos then indiceGojo = 1 end

            -- Teleporta para o jogador ATUAL da lista
            local alvo = vivos[indiceGojo]
            if alvo then
                pcall(function()
                    hrp.CFrame = alvo.CFrame * CFrame.new(0, 0, 2)
                    hrp.Velocity = Vector3.zero
                end)
            end

            -- Avança o índice (1 jogador por frame)
            indiceGojo = indiceGojo + 1
        end)

        table.insert(Estado.Conexoes, conexaoGojo)
    else
        GojoButton.BackgroundColor3 = CONFIG.COR_BOTAO
        GojoButton.Text = "Gojo 0.2"
        indiceGojo = 1
    end
end)-- ============================================================
