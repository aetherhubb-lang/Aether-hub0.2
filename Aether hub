}

local bordas = {
    {nome = "Norte", pos = Vector3.new(-16, 62, -347)},
    {nome = "Sul",   pos = Vector3.new(14, 63, 623)},
    {nome = "Leste", pos = Vector3.new(348, 62, 12)},
