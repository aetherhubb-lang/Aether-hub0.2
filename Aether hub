local function encontrarBordaMaisProxima()
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local minhaPos = hrp.Position
    local maisProxima, menorDist = nil, math.huge
    for _, borda in pairs(bordas) do
        local d = (minhaPos - borda.pos).Magnitude
        if d < menorDist then menorDist = d; maisProxima = borda end
    end
    return maisProxima
end

local function flyProVoid()
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false end
    local bordaAlvo = encontrarBordaMaisProxima()
    if not bordaAlvo then return false end

    local mult = velocidadesBypass[velocidadeAtual].mult
    local og, os, oj = workspace.Gravity, hum.WalkSpeed, hum.JumpPower
    workspace.Gravity = 0; hum.WalkSpeed = 6; hum.JumpPower = 0

    local sp = hrp.Position
    TweenService:Create(hrp, TweenInfo.new(0.5*mult, Enum.EasingStyle.Linear),
        {CFrame = CFrame.new(sp.X, sp.Y + alturaSubida, sp.Z)}):Play()
    task.wait(0.6*mult)

    local pa = hrp.Position
    local dest = Vector3.new(bordaAlvo.pos.X * distanciaBorda, pa.Y, bordaAlvo.pos.Z * distanciaBorda)
    TweenService:Create(hrp, TweenInfo.new(2.5*mult, Enum.EasingStyle.Linear),
        {CFrame = CFrame.new(dest)}):Play()
    task.wait(2.7*mult)

    workspace.Gravity = og; hum.WalkSpeed = os; hum.JumpPower = oj
    local c3 = lp.Character
    local h3 = c3 and c3:FindFirstChild("HumanoidRootPart")
    if h3 then h3.CFrame = CFrame.new(h3.Position.X, -500, h3.Position.Z) end
    return true
end

