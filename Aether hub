local DF = {Cima=false, Baixo=false, Esquerda=false, Direita=false, Subir=false, Descer=false}
local function ligar(b, k)
    b.MouseButton1Down:Connect(function() DF[k] = true end)
    b.MouseButton1Up:Connect(function()   DF[k] = false end)
    b.MouseLeave:Connect(function()       DF[k] = false end)
end
