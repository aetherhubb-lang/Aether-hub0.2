local DirecaoFly = {
    Cima=false, Baixo=false, Esquerda=false, Direita=false,
    Subir=false, Descer=false
}

local function conectarSeta(btn, tecla)
    btn.MouseButton1Down:Connect(function() DirecaoFly[tecla] = true end)
    btn.MouseButton1Up:Connect(function()   DirecaoFly[tecla] = false end)
    btn.MouseLeave:Connect(function()       DirecaoFly[tecla] = false end)
end

