FlyBtn.MouseButton1Click:Connect(function()
    Estado.FlyAtivo = not Estado.FlyAtivo
    setLinhaAtiva(FlyBtn, FlyNome, Estado.FlyAtivo)

    if Estado.FlyAtivo then
        FlyControlsGui.Enabled = true
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        Estado.FlyGyro = Instance.new("BodyGyro")
        Estado.FlyGyro.P = 9e4
        Estado.FlyGyro.MaxTorque = Vector3.new(9e9,9e9,9e9)
        Estado.FlyGyro.CFrame = hrp.CFrame
        Estado.FlyGyro.Parent = hrp

        Estado.FlyVelocity = Instance.new("BodyVelocity")
        Estado.FlyVelocity.MaxForce = Vector3.new(9e9,9e9,9e9)
        Estado.FlyVelocity.Velocity = Vector3.zero
        Estado.FlyVelocity.Parent = hrp

        local con = RunService.RenderStepped:Connect(function()
            if not Estado.FlyAtivo or not hrp or not hrp.Parent then return end
            local mv = Vector3.zero
            local vel = 80
            if DF.Cima     then mv = mv + Camera.CFrame.LookVector end
            if DF.Baixo    then mv = mv - Camera.CFrame.LookVector end
            if DF.Esquerda then mv = mv - Camera.CFrame.RightVector end
            if DF.Direita  then mv = mv + Camera.CFrame.RightVector end
            if DF.Subir    then mv = mv + Vector3.new(0,1,0) end
            if DF.Descer   then mv = mv - Vector3.new(0,1,0) end
            if Estado.FlyVelocity then Estado.FlyVelocity.Velocity = mv * vel end
            if Estado.FlyGyro then Estado.FlyGyro.CFrame = Camera.CFrame end
        end)
        table.insert(Estado.Conexoes, con)
    else
        FlyControlsGui.Enabled = false
        if Estado.FlyGyro then Estado.FlyGyro:Destroy() Estado.FlyGyro = nil end
        if Estado.FlyVelocity then Estado.FlyVelocity:Destroy() Estado.FlyVelocity = nil end
    end
end)-- ============================================================
