    Estado.FlyAtivo = not Estado.FlyAtivo

    if Estado.FlyAtivo then
        FlyButton.BackgroundColor3 = CONFIG.COR_BOTAO_ATIVO
        FlyButton.Text = "Fly ✓"
        FlyControlsGui.Enabled = true

        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        Estado.FlyGyro = Instance.new("BodyGyro")
        Estado.FlyGyro.P = 9e4
        Estado.FlyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        Estado.FlyGyro.CFrame = hrp.CFrame
        Estado.FlyGyro.Parent = hrp

        Estado.FlyVelocity = Instance.new("BodyVelocity")
        Estado.FlyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        Estado.FlyVelocity.Velocity = Vector3.zero
        Estado.FlyVelocity.Parent = hrp

        local conexaoFly = RunService.RenderStepped:Connect(function()
            if not Estado.FlyAtivo or not hrp or not hrp.Parent then return end
            local moveDir = Vector3.zero
            local velocidade = 80
            if DirecaoFly.Cima     then moveDir = moveDir + Camera.CFrame.LookVector end
            if DirecaoFly.Baixo    then moveDir = moveDir - Camera.CFrame.LookVector end
            if DirecaoFly.Esquerda then moveDir = moveDir - Camera.CFrame.RightVector end
            if DirecaoFly.Direita  then moveDir = moveDir + Camera.CFrame.RightVector end
            if DirecaoFly.Subir    then moveDir = moveDir + Vector3.new(0, 1, 0) end
            if DirecaoFly.Descer   then moveDir = moveDir - Vector3.new(0, 1, 0) end

            if Estado.FlyVelocity then Estado.FlyVelocity.Velocity = moveDir * velocidade end
            if Estado.FlyGyro then Estado.FlyGyro.CFrame = Camera.CFrame end
        end)
        table.insert(Estado.Conexoes, conexaoFly)
    else
        FlyButton.BackgroundColor3 = CONFIG.COR_BOTAO
        FlyButton.Text = "Fly"
        FlyControlsGui.Enabled = false
        if Estado.FlyGyro then Estado.FlyGyro:Destroy() Estado.FlyGyro = nil end
        if Estado.FlyVelocity then Estado.FlyVelocity:Destroy() Estado.FlyVelocity = nil end
    end
