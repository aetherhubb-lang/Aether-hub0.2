-- 🎨 LOOP DE CORES (por tema / RGB)
-- ============================================================
task.spawn(function()
    local hue = 0
    while MainFrame.Parent do
        local tema = Temas[TemaAtual]
        local cor, espera

        if tema.nome == "RGB" then
            hue = (hue + 0.03) % 1
            cor = Color3.fromHSV(hue, 1, 1)
            espera = 0.05
        else
            cor = tema.cor
            espera = 0.3
        end

        CorAtual = cor
        local ti = TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)

        TweenService:Create(MainStroke,     ti, { Color = cor }):Play()
        TweenService:Create(LogoStroke,     ti, { Color = cor }):Play()
        TweenService:Create(Title,          ti, { TextColor3 = cor }):Play()
        TweenService:Create(MinButton,      ti, { TextColor3 = cor }):Play()
        TweenService:Create(MinStroke,      ti, { Color = cor }):Play()
        TweenService:Create(LockButton,     ti, { TextColor3 = cor }):Play()
        TweenService:Create(LockStroke,     ti, { Color = cor }):Play()
        TweenService:Create(ContentStroke,  ti, { Color = cor }):Play()
        TweenService:Create(ExtrasStroke,   ti, { Color = cor }):Play()
        TweenService:Create(MiniIcon,       ti, { TextColor3 = cor }):Play()
        TweenService:Create(KFS,            ti, { Color = cor }):Play()
        TweenService:Create(SubmitButton,   ti, { BackgroundColor3 = cor }):Play()
        TweenService:Create(KeyTitle,       ti, { TextColor3 = cor }):Play()

        task.wait(espera)
    end
end)

