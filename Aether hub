-- ================= GOJO 0.2 =================
local GojoButton = criarBotao("Gojo 0.2", 1)
local indiceGojo = 1

GojoButton.MouseButton1Click:Connect(function()
    Estado.GojoAtivo = not Estado.GojoAtivo

    if Estado.GojoAtivo then
        GojoButton.BackgroundColor3 = CONFIG.COR_BOTAO_ATIVO
        GojoButton.Text = "Gojo 0.2 ✓"
        indiceGojo = 1

        local conexaoGojo = RunService.Heartbeat:Connect(function()
            if not Estado.GojoAtivo then return end
            local char = LocalPlayer.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local vivos = {}
            for _, jogador in pairs(Players:GetPlayers()) do
                if jogador ~= LocalPlayer then
                    local charAlvo = jogador.Character
                    if charAlvo then
                        local hum = charAlvo:FindFirstChild("Humanoid")
                        local hrpAlvo = charAlvo:FindFirstChild("HumanoidRootPart")
                        if hum and hum.Health > 0 and hrpAlvo then
                            table.insert(vivos, hrpAlvo)
                        end
                    end
                end
            end

            if #vivos == 0 then return end
            if indiceGojo > #vivos then indiceGojo = 1 end

            local alvo = vivos[indiceGojo]
            if alvo then
                pcall(function()
                    hrp.CFrame = alvo.CFrame * CFrame.new(0, 0, 2)
                    hrp.Velocity = Vector3.zero
                end)
            end
            indiceGojo = indiceGojo + 1
        end)
        table.insert(Estado.Conexoes, conexaoGojo)
    else
        GojoButton.BackgroundColor3 = CONFIG.COR_BOTAO
        GojoButton.Text = "Gojo 0.2"
        indiceGojo = 1
    end
end)

-- ================= FOCUS (PERSONAGEM ORBITANDO) =================
local FocusButton = criarBotao("Focus", 2)

FocusButton.MouseButton1Click:Connect(function()
    Estado.FocusAtivo = not Estado.FocusAtivo

    if Estado.FocusAtivo then
        FocusButton.BackgroundColor3 = CONFIG.COR_BOTAO_ATIVO
        FocusButton.Text = "Focus ✓"
        local angulo = 0

        local conexaoFocus = RunService.Heartbeat:Connect(function(dt)
            if not Estado.FocusAtivo then return end
            local char = LocalPlayer.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local alvoProximo = nil
            local menorDist = math.huge
            for _, jogador in pairs(Players:GetPlayers()) do
                if jogador ~= LocalPlayer then
                    local charAlvo = jogador.Character
                    if charAlvo then
                        local hum = charAlvo:FindFirstChild("Humanoid")
                        local hrpAlvo = charAlvo:FindFirstChild("HumanoidRootPart")
                        if hum and hum.Health > 0 and hrpAlvo then
                            local dist = (hrpAlvo.Position - hrp.Position).Magnitude
                            if dist < menorDist then
                                menorDist = dist
                                alvoProximo = hrpAlvo
                            end
                        end
                    end
                end
            end

            if alvoProximo then
                angulo = angulo + dt * 6
                local raio = 5
                local offset = Vector3.new(
                    math.cos(angulo) * raio,
                    3,
                    math.sin(angulo) * raio
                )
                local destino = alvoProximo.Position + offset
                hrp.CFrame = CFrame.new(destino, alvoProximo.Position)
            end
        end)
        table.insert(Estado.Conexoes, conexaoFocus)
    else
        FocusButton.BackgroundColor3 = CONFIG.COR_BOTAO
        FocusButton.Text = "Focus"
    end
end)

