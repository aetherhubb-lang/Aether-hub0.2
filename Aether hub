-- FUNÇÃO: criar linha (estilo da imagem)
-- ============================================================
local function criarLinha(nomeBase, layoutOrder)
    local row = Instance.new("Frame")
    row.Name = nomeBase .. "Row"
    row.Size = UDim2.new(1, 0, 0, 42)
    row.BackgroundTransparency = 1
    row.LayoutOrder = layoutOrder or 99
    row.Parent = ContentFrame

    local btn = Instance.new("TextButton")
    btn.Name = nomeBase .. "Button"
    btn.Size = UDim2.new(1, 0, 1, -1)
    btn.BackgroundTransparency = 1
    btn.Text = nomeBase .. ": OFF"
    btn.TextColor3 = CONFIG.COR_TEXTO
    btn.TextSize = 14
    btn.Font = Enum.Font.GothamBold
    btn.BorderSizePixel = 0
    btn.Parent = row

    local div = Instance.new("Frame")
    div.Size = UDim2.new(0.92, 0, 0, 1)
    div.Position = UDim2.new(0.04, 0, 1, -1)
    div.BackgroundColor3 = CONFIG.COR_DIVISOR
    div.BorderSizePixel = 0
    div.Parent = row

    -- Hover
    btn.MouseEnter:Connect(function()
        if not btn:GetAttribute("ativo") then
            btn.TextColor3 = CONFIG.COR_TEXTO_ATIVO
        end
    end)
    btn.MouseLeave:Connect(function()
        if not btn:GetAttribute("ativo") then
            btn.TextColor3 = CONFIG.COR_TEXTO
        end
    end)

    return btn, nomeBase
end

-- Helper: marcar ativo/desativado
local function setLinhaAtiva(btn, nomeBase, ativo)
    btn:SetAttribute("ativo", ativo)
    btn.Text = nomeBase .. (ativo and ": ON" or ": OFF")
    btn.TextColor3 = ativo and CONFIG.COR_TEXTO_ATIVO or CONFIG.COR_TEXTO
end

