-- LIMPEZA
-- ============================================================
local function limpar()
    for _, c in pairs(Estado.Conexoes) do pcall(function() c:Disconnect() end) end
    Estado.Conexoes = {}
    if Estado.FlyGyro then pcall(function() Estado.FlyGyro:Destroy() end) end
    if Estado.FlyVelocity then pcall(function() Estado.FlyVelocity:Destroy() end) end
    pcall(function() ScreenGui:Destroy() end)
end

