local function setLinhaAtiva(btn, nomeBase, ativo)
    btn:SetAttribute("ativo", ativo)
    btn.Text = nomeBase .. (ativo and ": ON" or ": OFF")
    if ativo then
        btn.TextColor3 = CorAtual or PurpleColors[1]
    else
        btn.TextColor3 = COR_TEXTO_OFF
    end
end

