-- FUNÇÃO: Achar borda mais próxima
local function encontrarBordaMaisProxima()
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local minhaPos = hrp.Position
    local maisProxima = nil
    local menorDist = math.huge

    for _, borda in pairs(bordas) do
        local dist = (minhaPos - borda.pos).Magnitude
        if dist < menorDist then
            menorDist = dist
            maisProxima = borda
        end
    end

    return maisProxima
end

-- FUNÇÃO: Voa pro void
local function flyProVoid()
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false end

    local bordaAlvo = encontrarBordaMaisProxima()
    if not bordaAlvo then return false end

    local mult = velocidadesBypass[velocidadeAtual].mult

    local originalGravity = workspace.Gravity
    local originalSpeed = hum.WalkSpeed
    local originalJump = hum.JumpPower

    workspace.Gravity = 0
    hum.WalkSpeed = 6
    hum.JumpPower = 0

    local startPos = hrp.Position
    local tweenSubir = TweenService:Create(
        hrp,
        TweenInfo.new(0.5 * mult, Enum.EasingStyle.Linear),
        {CFrame = CFrame.new(startPos.X, startPos.Y + alturaSubida, startPos.Z)}
    )
    tweenSubir:Play()
    task.wait(0.6 * mult)

    local posAtual = hrp.Position
    local destino = Vector3.new(
        bordaAlvo.pos.X * distanciaBorda,
        posAtual.Y,
        bordaAlvo.pos.Z * distanciaBorda
    )
    local tweenLado = TweenService:Create(
        hrp,
        TweenInfo.new(2.5 * mult, Enum.EasingStyle.Linear),
        {CFrame = CFrame.new(destino)}
    )
    tweenLado:Play()
    task.wait(2.7 * mult)

    workspace.Gravity = originalGravity
    hum.WalkSpeed = originalSpeed
    hum.JumpPower = originalJump

    local c3 = lp.Character
    local h3 = c3 and c3:FindFirstChild("HumanoidRootPart")
    if h3 then
        h3.CFrame = CFrame.new(h3.Position.X, -500, h3.Position.Z)
    end

    return true
end

