-- ================= BOTÃO 4: ATIVAR BYPASS =================
local BypassButton = criarBotao("Ativar Bypass", 4)
local BypassAtivo = false

BypassButton.MouseButton1Click:Connect(function()
    if BypassAtivo then
        BypassButton.Text = "Bypass já ativo ✓"
        return
    end

    BypassAtivo = true
    BypassButton.BackgroundColor3 = CONFIG.COR_BOTAO_ATIVO
    BypassButton.Text = "Bypass Ativo ✓"

    -- ========== BOTÃO: AUTO BYPASS ==========
    local AutoBypassBtn = criarBotao("🛡️ Auto Bypass", 5)

    AutoBypassBtn.MouseButton1Click:Connect(function()
        if autoBypassActive then
            autoBypassActive = false
            AutoBypassBtn.BackgroundColor3 = Tema.card
            AutoBypassBtn.TextColor3 = Tema.texto
            AutoBypassBtn.Text = "🛡️ Auto Bypass"
            return
        end

        autoBypassActive = true
        AutoBypassBtn.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
        AutoBypassBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        AutoBypassBtn.Text = "Voando..."

        task.spawn(function()
            local volta = 0
            while autoBypassActive do
                volta = volta + 1
                AutoBypassBtn.Text = "Voando (v" .. volta .. ")"
                AutoBypassBtn.BackgroundColor3 = Color3.fromRGB(200, 0, 200)

                flyProVoid()
                task.wait(2)
                if not autoBypassActive then break end

                local char = lp.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hum or not hrp then
                    AutoBypassBtn.Text = "Sem char (v" .. volta .. ")"
                    task.wait(1)
                    continue
                end

                local posVoid = hrp.Position

                -- Acha dummy mais próximo
                local dummyAlvo = nil
                local menorDist = math.huge
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj:IsA("Model")
                       and obj:FindFirstChildOfClass("Humanoid")
                       and obj ~= char
                       and not Players:GetPlayerFromCharacter(obj) then
                        local dHum = obj:FindFirstChildOfClass("Humanoid")
                        local dHrp = obj:FindFirstChild("HumanoidRootPart")
                        if dHum and dHrp and dHum.Health > 0 then
                            local dist = (hrp.Position - dHrp.Position).Magnitude
                            if dist < menorDist then
                                menorDist = dist
                                dummyAlvo = dHrp
                            end
                        end
                    end
                end

                if not dummyAlvo then
                    AutoBypassBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
                    AutoBypassBtn.Text = "Sem dummy (v" .. volta .. ")"
                    task.wait(2)
                else
                    local posDummy = dummyAlvo.Position
                    AutoBypassBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
                    AutoBypassBtn.Text = "TP teste (v" .. volta .. ")"
                    pcall(function()
                        hrp.CFrame = CFrame.new(posDummy + Vector3.new(0, 3, 0))
                    end)
                    task.wait(1.5)

                    local hrpAtual = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                    if not hrpAtual then
                        AutoBypassBtn.Text = "Perdeu char (v" .. volta .. ")"
                        task.wait(1)
                    else
                        local posAtual = hrpAtual.Position
                        local distDummy = (posAtual - posDummy).Magnitude
                        local distVolta = (posAtual - posVoid).Magnitude

                        if distDummy < 20 then
                            AutoBypassBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
                            AutoBypassBtn.Text = "✅ OK! (v" .. volta .. ")"
                            autoBypassActive = false
                            break
                        elseif distVolta < 20 then
                            AutoBypassBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
                            AutoBypassBtn.Text = "❌ Bloqueou (v" .. volta .. ")"
                            task.wait(1.5)
                        else
                            AutoBypassBtn.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
                            AutoBypassBtn.Text = "⚠️ Outro lugar (v" .. volta .. ")"
                            task.wait(1.5)
                        end
                    end
                end
                task.wait(0.5)
            end

            autoBypassActive = false
            task.wait(2)
            AutoBypassBtn.BackgroundColor3 = Tema.card
            AutoBypassBtn.TextColor3 = Tema.texto
            AutoBypassBtn.Text = "🛡️ Auto Bypass"
        end)
    end)

    -- ========== BOTÃO: VELOCIDADE ==========
    local VelocidadeBtn = criarBotao("🚀 Velocidade: " .. velocidadesBypass[velocidadeAtual].nome, 6)

    VelocidadeBtn.MouseButton1Click:Connect(function()
        velocidadeAtual = velocidadeAtual + 1
        if velocidadeAtual > #velocidadesBypass then velocidadeAtual = 1 end
        VelocidadeBtn.Text = "🚀 Velocidade: " .. velocidadesBypass[velocidadeAtual].nome
        VelocidadeBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        task.wait(0.2)
        VelocidadeBtn.BackgroundColor3 = Tema.card
    end)
end)

