-- ================= GOJO 0.2 =================
local GojoBtn, GojoNome = criarLinha("Gojo 0.2", 1)
local indiceGojo = 1

GojoBtn.MouseButton1Click:Connect(function()
    Estado.GojoAtivo = not Estado.GojoAtivo
    setLinhaAtiva(GojoBtn, GojoNome, Estado.GojoAtivo)

    if Estado.GojoAtivo then
        indiceGojo = 1
        local conexaoGojo = RunService.Heartbeat:Connect(function()
            if not Estado.GojoAtivo then return end
            local char = LocalPlayer.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local vivos = {}
            for _, jog in pairs(Players:GetPlayers()) do
                if jog ~= LocalPlayer then
                    local c = jog.Character
                    if c then
                        local h = c:FindFirstChild("Humanoid")
                        local r = c:FindFirstChild("HumanoidRootPart")
                        if h and h.Health > 0 and r then table.insert(vivos, r) end
                    end
                end
            end

            if #vivos == 0 then return end
            if indiceGojo > #vivos then indiceGojo = 1 end

            local alvo = vivos[indiceGojo]
            if alvo then
                pcall(function()
                    hrp.CFrame = alvo.CFrame * CFrame.new(0, 0, 2)
                    hrp.Velocity = Vector3.zero
                end)
            end
            indiceGojo = indiceGojo + 1
        end)
        table.insert(Estado.Conexoes, conexaoGojo)
    end
end)

