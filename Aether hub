SubmitButton.MouseButton1Click:Connect(function()
    if KeyInput.Text == CONFIG.KEY_VALIDA then
        KeyGui.Enabled = false
        MainFrame.Visible = true
        print("[Aether Hub] Key correta! Hub liberado.")
    else
        KeyInput.Text = ""
        KeyInput.PlaceholderText = "❌ Key incorreta! Tente novamente."
        KeyInput.PlaceholderColor3 = Color3.fromRGB(255, 100, 100)
    end
end)

MainFrame.Visible = false
KeyGui.Enabled = true

-- ============================================================
-- ATALHO (RightCtrl)
-- ============================================================
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.RightControl then
        if Estado.HubAberto then
            ContentFrame.Visible = false
            MainFrame.Size = UDim2.new(0, 280, 0, 38)
            MinimizeButton.Text = "+"
            Estado.HubAberto = false
        else
            ContentFrame.Visible = true
            MainFrame.Size = CONFIG.TAMANHO_HUB
            MinimizeButton.Text = "−"
            Estado.HubAberto = true
        end
    end
end)

-- ============================================================
-- LIMPEZA
-- ============================================================
local function limpar()
    for _, conexao in pairs(Estado.Conexoes) do
        pcall(function() conexao:Disconnect() end)
    end
    Estado.Conexoes = {}
    if Estado.FlyGyro then pcall(function() Estado.FlyGyro:Destroy() end) end
    if Estado.FlyVelocity then pcall(function() Estado.FlyVelocity:Destroy() end) end
    pcall(function() ScreenGui:Destroy() end)
end

print("[Aether Hub] Script carregado! Use a key 'teste' para liberar o hub.")
