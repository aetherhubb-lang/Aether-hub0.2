-- BYPASS
local BypassBtn, BypassNome = criarLinha("Bypass", 4)
local BypassAtivo = false

BypassBtn.MouseButton1Click:Connect(function()
    if BypassAtivo then
        setLinhaAtiva(BypassBtn, BypassNome, false)
        BypassAtivo = false
        local a = Content:FindFirstChild("AutoBypassRow")
        local v = Content:FindFirstChild("VelocidadeRow")
        if a then a:Destroy() end
        if v then v:Destroy() end
        return
    end
    BypassAtivo = true
    setLinhaAtiva(BypassBtn, BypassNome, true)

    local AutoBypassBtn, AutoNome = criarLinha("🛡️ Auto Bypass", 5)
    AutoBypassBtn.Parent.Name = "AutoBypassRow"

    AutoBypassBtn.MouseButton1Click:Connect(function()
        if autoBypassActive then
            autoBypassActive = false
            setLinhaAtiva(AutoBypassBtn, AutoNome, false)
            return
        end
        autoBypassActive = true
        setLinhaAtiva(AutoBypassBtn, AutoNome, true)

        task.spawn(function()
            local volta = 0
            while autoBypassActive do
                volta = volta + 1
                flyProVoid()
                task.wait(2)
                if not autoBypassActive then break end

                local char = lp.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hum or not hrp then task.wait(1); continue end
                local posVoid = hrp.Position

                local dummyAlvo, menorDist = nil, math.huge
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid")
                       and obj ~= char and not Players:GetPlayerFromCharacter(obj) then
                        local dH = obj:FindFirstChildOfClass("Humanoid")
                        local dR = obj:FindFirstChild("HumanoidRootPart")
                        if dH and dR and dH.Health > 0 then
                            local d = (hrp.Position - dR.Position).Magnitude
                            if d < menorDist then menorDist = d; dummyAlvo = dR end
                        end
                    end
                end

                if dummyAlvo then
                    local posDummy = dummyAlvo.Position
                    pcall(function()
                        hrp.CFrame = CFrame.new(posDummy + Vector3.new(0,3,0))
                    end)
                    task.wait(1.5)
                    local hrpAt = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                    if hrpAt then
                        local dD = (hrpAt.Position - posDummy).Magnitude
                        local dV = (hrpAt.Position - posVoid).Magnitude
                        if dD < 20 then
                            setLinhaAtiva(AutoBypassBtn, "✅ OK! v"..volta, true)
                            autoBypassActive = false
                            break
                        elseif dV < 20 then
                            task.wait(1.5)
                        else
                            task.wait(1.5)
                        end
                    end
                else
                    task.wait(2)
                end
                task.wait(0.5)
            end
            autoBypassActive = false
            task.wait(1)
            setLinhaAtiva(AutoBypassBtn, AutoNome, false)
        end)
    end)

    local VelBtn = criarLinha("🚀 Velocidade: " .. velocidadesBypass[velocidadeAtual].nome, 6)
    VelBtn.Parent.Name = "VelocidadeRow"

    VelBtn.MouseButton1Click:Connect(function()
        velocidadeAtual = velocidadeAtual + 1
        if velocidadeAtual > #velocidadesBypass then velocidadeAtual = 1 end
        VelBtn.Text = "🚀 Velocidade: " .. velocidadesBypass[velocidadeAtual].nome
    end)
end)

